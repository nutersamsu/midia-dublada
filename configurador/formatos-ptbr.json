{
  "_leia": "Regras do filtro de idioma (Radarr e Sonarr). Cada regra dá pontos conforme o modo escolhido no instalador (IDIOMA no .env: dublado, ambos ou legendado). Uma versão só é baixada com pontuação >= minimo do modo. 'idiomas' usa o nome do idioma no Radarr/Sonarr; 'regex' confere o nome da versão. Mude aqui e rode: sudo ./gerenciar.sh reconfigurar",
  "modos": {
    "dublado":   { "rotulo": "Dublado",              "minimo": 100, "parar": 110 },
    "ambos":     { "rotulo": "Dublado ou legendado", "minimo": 30,  "parar": 110 },
    "legendado": { "rotulo": "Legendado",            "minimo": 0,   "parar": 150 }
  },
  "qualidades": {
    "720p": {
      "alvo": "Bluray-720p",
      "lista": ["SDTV", "DVD", "DVD-R", "WEB 480p", "Bluray-480p", "Bluray-576p",
                "HDTV-720p", "WEB 720p", "Bluray-720p"]
    },
    "1080p": {
      "alvo": "Bluray-1080p",
      "lista": ["SDTV", "DVD", "DVD-R", "WEB 480p", "Bluray-480p", "Bluray-576p",
                "HDTV-720p", "WEB 720p", "Bluray-720p",
                "HDTV-1080p", "WEB 1080p", "Bluray-1080p"]
    },
    "4k": {
      "alvo": "Bluray-2160p",
      "lista": ["SDTV", "DVD", "DVD-R", "WEB 480p", "Bluray-480p", "Bluray-576p",
                "HDTV-720p", "WEB 720p", "Bluray-720p",
                "HDTV-1080p", "WEB 1080p", "Bluray-1080p",
                "HDTV-2160p", "WEB 2160p", "Bluray-2160p"]
    }
  },
  "formatos": [
    {
      "nome": "🇧🇷 Idioma PT-BR",
      "pontos": { "dublado": 100, "ambos": 100, "legendado": 0 },
      "idiomas": ["Portuguese (Brazil)", "Portuguese"]
    },
    {
      "nome": "🇧🇷 Dublado no nome",
      "pontos": { "dublado": 100, "ambos": 100, "legendado": -40 },
      "regex": "(?i)\\b(dublado|nacional|pt[ ._-]?br|br[ ._-]?dub|portugu[eê]s)\\b"
    },
    {
      "nome": "DUAL áudio",
      "pontos": { "dublado": 10, "ambos": 10, "legendado": 50 },
      "regex": "(?i)\\bdual\\b"
    },
    {
      "nome": "💬 Legendado no nome",
      "pontos": { "dublado": -1000, "ambos": 50, "legendado": 100 },
      "regex": "(?i)\\b(legendado|leg|legendas?)\\b"
    },
    {
      "nome": "🚫 Legenda fixa (hardsub)",
      "pontos": { "dublado": -1000, "ambos": -20, "legendado": -20 },
      "regex": "(?i)\\b(hc|hardsub|hardcoded|korsub)\\b"
    },
    {
      "nome": "🚫 Outro idioma no nome",
      "pontos": { "dublado": -1000, "ambos": -1000, "legendado": -1000 },
      "regex": "(?i)\\b(hindi|tamil|telugu|malayalam|kannada|bengali|latino|castellano|spanish|espa[nñ]ol|french|truefrench|vff?|vostfr|italian|ita|german|deutsch|russian|rus|ukr|ukrainian|polish|turkish|korean|japanese|chinese|arabic)\\b"
    }
  ],
  "formatos_antigos": ["🚫 Legendado / legenda fixa"]
}
